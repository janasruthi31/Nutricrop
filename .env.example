# Environment Configuration Example
# Do not commit secrets or real credentials to source control.

PORT=8000
HOST=0.0.0.0
API_KEY=test_api_key_tn_fertilizer_optimizer
DEBUG=True

# Soil Report Storage Directory
STORAGE_DIR=./data/uploads

# Maximum Upload File Size in Bytes (10MB)
MAX_UPLOAD_BYTES=10485760

# Database Path
DATABASE_PATH=./soil_analysis.db

# Authentication Configuration
JWT_SECRET=replace_with_secure_random_hex_key_for_production
JWT_EXPIRATION_MINUTES=1440

# Weather API Configuration
OPEN_METEO_TIMEOUT_SECONDS=5.0
WEATHER_CACHE_TTL_MINUTES=60
